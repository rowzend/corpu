# Application Branding Configuration
# These values will be displayed on the landing page and throughout the application

# Short application name (displayed in title, branding, etc.)
APP_NAME=ASNCORPU

# Full application name/description (displayed in subtitle)
APP_LONG_NAME=ASN Corpu Backend System

# Institution/Organization name
APP_INSTANSI=ASN Corpu Organization

# Application description (can be used in meta tags, about page, etc.)
APP_DESCRIPTION=Backend system for ASN Corpu platform

# Internal key prefix (cache/redis)
APP_KEY_PREFIX=asncorpu-backend

# MinIO / S3-compatible Storage (dokumen, file upload)
MINIO_ENDPOINT=http://172.16.7.66:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=asncorpu
MINIO_REGION=us-east-1
MINIO_USE_PROXY=True
MINIO_PROXY_URL=/media/minio/
